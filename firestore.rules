rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function admin() {
      return signedIn()
        && request.auth.token.email == 'hafzaywb553@gmail.com';
    }

    function ownsExisting() {
      return signedIn()
        && resource.data.userId == request.auth.uid;
    }

    function ownsNew() {
      return signedIn()
        && request.resource.data.userId == request.auth.uid;
    }

    match /user_profiles/{userId} {
      allow read: if admin() || (signedIn() && userId == request.auth.uid);
      allow create: if admin() || (
        signedIn()
        && userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid
      );
      allow update: if admin() || (
        signedIn()
        && userId == request.auth.uid
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid
      );
      allow delete: if admin() || (
        signedIn()
        && userId == request.auth.uid
        && resource.data.userId == request.auth.uid
      );
    }

    match /personnel/{id} {
      allow read: if admin() || ownsExisting();
      allow create: if admin() || ownsNew();
      allow update: if admin() || (
        ownsExisting()
        && request.resource.data.userId == request.auth.uid
      );
      allow delete: if admin() || ownsExisting();
    }

    match /payroll/{id} {
      allow read: if admin() || ownsExisting();
      allow create: if admin() || ownsNew();
      allow update: if admin() || (
        ownsExisting()
        && request.resource.data.userId == request.auth.uid
      );
      allow delete: if admin() || ownsExisting();
    }

    match /transactions/{id} {
      allow read: if admin() || ownsExisting();
      allow create: if admin() || ownsNew();
      allow update: if admin() || (
        ownsExisting()
        && request.resource.data.userId == request.auth.uid
      );
      allow delete: if admin() || ownsExisting();
    }

    match /audit/{id} {
      allow read: if admin() || ownsExisting();
      allow create: if admin() || ownsNew();
      allow update, delete: if false;
    }

    match /presence/{userId} {
      allow read: if signedIn();
      allow create, update: if signedIn() && userId == request.auth.uid;
      allow delete: if signedIn() && userId == request.auth.uid;
    }
  }
}
